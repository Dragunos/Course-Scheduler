<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.edu.haui.scheduler.ui.controller.HomeController"
            stylesheets="@../css/home.css"
            prefWidth="1200"
            prefHeight="680"
            styleClass="root">

    <!-- ===== TOP BAR ===== -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="top-bar">

            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <Button fx:id="loginButton"
                    text="Đăng nhập"
                    onAction="#onLogin"
                    styleClass="secondary-button"/>

            <Button fx:id="registerButton"
                    text="Đăng ký"
                    onAction="#onRegister"
                    styleClass="primary-button"/>

            <Button fx:id="logoutButton"
                    text="Đăng xuất"
                    visible="false"
                    onAction="#onLogout"
                    styleClass="danger-button"/>
        </HBox>
    </top>

    <!-- ===== LEFT MENU ===== -->
    <left>
        <VBox spacing="10"
              prefWidth="240"
              styleClass="side-menu">

            <padding>
                <Insets top="24" right="16" bottom="24" left="16"/>
            </padding>

            <Label text="CHỨC NĂNG"
                   styleClass="menu-title"/>

            <Button fx:id="danhSachMenuButton"
        			text="Danh sách lớp học phần"
        			maxWidth="Infinity"
        			onAction="#onShowDanhSachLopPane"
        			styleClass="menu-button"/>


            <Button fx:id="importMenuButton"
                    text="Nhập danh sách lớp"
                    maxWidth="Infinity"
                    onAction="#onShowImportPane"
                    styleClass="menu-button"/>

            <Separator/>

            <Button fx:id="optimizeMenuButton"
       				text="Sinh thời khóa biểu"
        			maxWidth="Infinity"
        			styleClass="menu-button"
        			onAction="#onShowOptimizerPane"/>

            <Button fx:id="thoiKhoaBieuMenuButton"
        			text="Thời khóa biểu của tôi"
        			maxWidth="Infinity"
        			styleClass="menu-button"
        			onAction="#onShowThoiKhoaBieuPane"/>

            <Separator/>

            <Label fx:id="adminLabel"
                   text="QUẢN TRỊ"
                   styleClass="menu-title"/>

            <Button fx:id="adminListButton"
					text="Danh sách lớp hệ thống"
      				visible="false"
      				maxWidth="Infinity"
      				styleClass="menu-button"
      				onAction="#onShowAdminDanhSachPane"/>

        </VBox>
    </left>

    <!-- ===== CENTER ===== -->
    <center>
        <VBox fx:id="centerContainer"
              alignment="CENTER"
              spacing="16"
              styleClass="home-center">

            <Label fx:id="welcomeLabel"
                   text="Chào mừng bạn"
                   styleClass="home-title"/>

            <Label fx:id="subTitleLabel"
                   text="Hệ thống hỗ trợ xếp thời khóa biểu"
                   styleClass="home-subtitle"/>
        </VBox>
    </center>

</BorderPane>
